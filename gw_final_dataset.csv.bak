yiv1429338740 .smallersidebar {font-family:verdana, arial, helvetica, sans-serif;font-size:10px;color:#003366;} #yiv1429338740 .emphasis {font-weight:700;} #yiv1429338740 table#invoice,#yiv1429338740 table#invoice_controls,#yiv1429338740 table#invoice_note {width:600px;} #yiv1429338740 table#invoice_note {margin-top:10px;margin-bottom:10px;} #yiv1429338740 table#invoice_controls {text-align:right;} #yiv1429338740 table#invoice {border-collapse:collapse;border:1px solid #aaa;} #yiv1429338740 table#invoice td {font-size:11px;border:1px solid #ccc;padding:2px;} #yiv1429338740 table#invoice td.field_label_right,#yiv1429338740 table#invoice td.field_label_right_error {font-weight:bold;text-align:right;} #yiv1429338740 table#invoice td.field_label_right_error,#yiv1429338740 table#invoice td.field_label_error {color:red;} #yiv1429338740 table#invoice tr.title td {font-weight:bold;line-height:20px;text-align:left;background-color:#ccddee;} #yiv1429338740 table#invoice input.readonly {border:0;text-align:right;} #yiv1429338740 table#invoice input.readonly_currency {border:0;width:10px;} #yiv1429338740 .field_error,#yiv1429338740 .field_error input.readonly_currency {background-color:#ff3333;} #yiv1429338740 .currency_highlight {background-color:#ffffcc;} #yiv1429338740 .tax {font-weight:400;float:left;} #yiv1429338740 table#invoice td span.curr {float:left;} #yiv1429338740 table#invoice td.currency {border-right:1px solid #fff;} #yiv1429338740 table#invoice td.calc {font-weight:bold;text-align:right;} #yiv1429338740 .inlineblue {color:#00f;} #yiv1429338740 .small {font-size:11px;font-weight:400;} #yiv1429338740 hr.solid {width:100%;margin-top:5px;margin-bottom:0px;border-left:#fff;border-right:#fff;border-top:#fff;border-bottom:2px solid #999;} #yiv1429338740 .large {font-size:17px;} #yiv1429338740 .smallverdanagrey{font-family:verdana;font-size:10px;color:#999999;} #yiv1429338740 .smallverdana {font-family:verdana;font-size:10px;color:#000000;} #yiv1429338740 .smallarial {f