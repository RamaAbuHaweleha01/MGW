ial,helvetica,sans-serif;font-size: 10px;color: #003366;} #message .emphasis {font-weight: 700;} #message table#invoice, #message table#invoice_controls, #message table#invoice_note { width: 600px;} #message table#invoice_note {margin-top:10px; margin-bottom:10px;} #message table#invoice_controls {text-align: right;} #message table#invoice {border-collapse: collapse; border:1px solid #aaa; } #message table#invoice td {font-size:11px; border:1px solid #ccc; padding:2px;} #message table#invoice td.field_label_right, #message table#invoice td.field_label_right_error {font-weight:bold; text-align:right;} #message table#invoice td.field_label_right_error, #message table#invoice td.field_label_error {color:red;} #message table#invoice tr.title td {font-weight:bold; line-height:20px; text-align:left; background-color: #ccddee;} #message table#invoice input.readonly {border:0; text-align:right;} #message table#invoice input.readonly_currency {border:0; width:10px;} #message .field_error, #message .field_error input.readonly_currency {background-color:#ff3333;} #message .currency_highlight {background-color: #ffffcc;} #message .tax {font-weight: 400; float: left;} #message table#invoice td span.curr {float: left;} #message table#invoice td.currency {border-right:1px solid #fff;} #message table#invoice td.calc {font-weight:bold; text-align:right;} #message .inlineblue {color: #00f;} #message .small {font-size: 11px; font-weight: 400;} #message hr.solid {width: 100%; margin-top: 5px; margin-bottom: 0px; border-left: #fff; border-right: #fff; border-top: #fff; border-bottom: 2px solid #999;} #message .large {font-size: 17px;} #message .smallverdanagrey{font-family: verdana; font-size: 10px; color: #999999;} #message .smallverdana {font-family: verdana; font-size: 10px; color :#000000;} #message .smallarial {font-family: arial; font-size: 13px; } #message .smallarialblue {font-family: verdana; font-size: 9px; color: #0000ff;} #message .smallverdanagreen{font-family: verdana; fon